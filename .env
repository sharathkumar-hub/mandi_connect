NODE_ENV=development
PORT=5000
MONGODB_URI=

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Fast2SMS - FREE for Indian numbers (recommended)
# Get API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Twilio credentials (optional - paid service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudinary credentials (required for image upload)
# Get these from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=-

# Razorpay credentials (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Weather API (optional)
WEATHER_API_KEY=

FRONTEND_URL=http://:
